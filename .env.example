# HuggingFace Token (obrigatório para treinamento)
# Obtenha em: https://huggingface.co/settings/tokens
HF_TOKEN=seu_token_huggingface_aqui

# Wandb (opcional - para tracking de experimentos)
# WANDB_API_KEY=seu_token_wandb_aqui

# Configurações de cache (opcional)
# HF_HOME=/home/seu_usuario/.cache/huggingface
# OUTPUT_DIR=/home/seu_usuario/projetos/auto-gliphs/output
